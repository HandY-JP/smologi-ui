{
  "name": "@handy-jp/smologi-ui",
  "version": "0.19.0",
  "description": "スモロジ系列アプリ（Logistic / Seller / ポータル / B2B）で共有する UI 部品とデザイントークン",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HandY-JP/smologi-ui.git"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "tokens",
    "tailwind-preset.cjs",
    "scripts/check-typography.mjs",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dashboard-kit": {
      "types": "./dist/dashboard-kit/ui.d.ts",
      "import": "./dist/dashboard-kit/ui.js"
    },
    "./styles.css": "./dist/styles/components.css",
    "./integration.css": "./dist/styles/integration.css",
    "./dark-compat.css": "./dist/styles/dark-compat.css",
    "./dark-compat-core.css": "./dist/styles/dark-compat-core.css",
    "./dark-compat-fields.css": "./dist/styles/dark-compat-fields.css",
    "./tokens/logistic.css": "./tokens/logistic.css",
    "./tokens/seller.css": "./tokens/seller.css",
    "./tokens/portal.css": "./tokens/portal.css",
    "./tokens/research.css": "./tokens/research.css",
    "./tokens/b2b.css": "./tokens/b2b.css",
    "./tokens/mobile.css": "./tokens/mobile.css",
    "./tokens/palette.css": "./tokens/palette.css",
    "./tokens/palette-compat.css": "./tokens/palette-compat.css",
    "./tokens/typography.css": "./tokens/typography.css",
    "./tokens/_contract.css": "./tokens/_contract.css",
    "./package.json": "./package.json",
    "./tailwind-preset": "./tailwind-preset.cjs"
  },
  "scripts": {
    "build": "node scripts/check-palette.mjs && node scripts/check-typography.mjs && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "node --test scripts/*.test.mjs && vitest run tests",
    "check:typography": "node scripts/check-typography.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@dnd-kit/core": "^6.3.1"
  },
  "peerDependenciesMeta": {
    "@dnd-kit/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "jsdom": "^26.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "bin": {
    "smologi-check-typography": "./scripts/check-typography.mjs"
  }
}
